[Unit]
Description=dm20 boot setup (code update, settings from SSM, campaign repo sync)
Wants=network-online.target
After=network-online.target
Before=dm20.service dm20-cloudflared.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/dm20/app/deploy/bin/dm20-boot
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
